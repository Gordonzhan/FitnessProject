# Copy this file to backend/.env and fill in the real values.
# Spring Boot will load it automatically when the working directory is backend.
# Do not commit backend/.env.

FITNESS_DB_URL=jdbc:mysql://localhost:3306/fitness_diary?useSSL=false&serverTimezone=UTC
FITNESS_DB_USERNAME=root
FITNESS_DB_PASSWORD=replace_with_your_local_mysql_password

# 数据库连接池与性能告警（默认值适合本地和单实例小规模部署）。
FITNESS_DB_POOL_MAX_SIZE=10
FITNESS_DB_POOL_MIN_IDLE=2
FITNESS_DB_CONNECTION_TIMEOUT_MS=5000
FITNESS_DB_VALIDATION_TIMEOUT_MS=3000
FITNESS_DB_IDLE_TIMEOUT_MS=600000
FITNESS_DB_MAX_LIFETIME_MS=1800000
FITNESS_SLOW_QUERY_MS=300
FITNESS_SLOW_REQUEST_MS=800
FITNESS_CATEGORY_CACHE_TTL_SECONDS=300
FITNESS_USER_CACHE_TTL_SECONDS=30
FITNESS_USER_CACHE_MAX_SIZE=10000
FITNESS_LOG_LEVEL=info
FITNESS_BUSINESS_ZONE=Asia/Shanghai

# R2 审计日志保留策略：默认保留 90 天，每天 03:20 清理；0 表示关闭自动清理。
# 正式环境建议根据合规和存储要求设置为 30～90 天。
FITNESS_AUDIT_RETENTION_DAYS=90
FITNESS_AUDIT_CLEANUP_CRON=0 20 3 * * *

# Spring multipart upload limits. Each image is uploaded in a separate request.
FITNESS_UPLOAD_MAX_FILE_SIZE=20MB
FITNESS_UPLOAD_MAX_REQUEST_SIZE=20MB

# 本地联调保持 true，会复用 database.sql 中的测试用户和既有数据。
# 上线前改为 false，并配置真实 AppID、AppSecret 和固定随机令牌密钥。
# 只有正式发布环境设置 FITNESS_PRODUCTION_MODE=true；配置不安全时后端会拒绝启动。
FITNESS_PRODUCTION_MODE=false
FITNESS_WECHAT_MOCK_ENABLED=true
FITNESS_WECHAT_MOCK_OPENID=test_openid
FITNESS_WECHAT_APP_ID=your_wechat_miniprogram_app_id
FITNESS_WECHAT_APP_SECRET=your_wechat_miniprogram_app_secret

# R7 本地演示数据开关；生产环境必须保持 false
FITNESS_COMPARISON_INCLUDE_SYNTHETIC=false
FITNESS_COMPARISON_MINIMUM_SAMPLE_SIZE=10
FITNESS_COMPARISON_REAL_SNAPSHOT_ENABLED=false
FITNESS_COMPARISON_HASH_SECRET=replace_with_an_independent_random_secret_at_least_32_chars
FITNESS_COMPARISON_MINIMUM_USER_EVENTS=4
FITNESS_COMPARISON_SNAPSHOT_CRON=0 10 4 * * *
FITNESS_AUTH_TOKEN_SECRET=replace_with_a_random_secret_at_least_32_bytes
FITNESS_AUTH_TOKEN_TTL_SECONDS=604800

FITNESS_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
FITNESS_OSS_REGION=cn-beijing
FITNESS_OSS_ACCESS_KEY_ID=replace_with_your_ram_access_key_id
FITNESS_OSS_ACCESS_KEY_SECRET=replace_with_your_ram_access_key_secret
FITNESS_OSS_BUCKET_NAME=replace_with_your_bucket_name
FITNESS_OSS_IMAGE_DIR=fitness-diary/images/

# U1 OSS 直传当前暂停，正常代理上传不需要以下变量。只有以后明确启用 U1 时再配置。
# FITNESS_OSS_STS_ROLE_ARN=acs:ram::replace_with_account_id:role/replace_with_upload_role
# FITNESS_OSS_UPLOAD_TICKET_TTL_SECONDS=300
# FITNESS_OSS_UPLOAD_TICKET_CLEANUP_DELAY_MS=60000
