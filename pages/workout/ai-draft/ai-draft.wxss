.ai-workout-page { padding-bottom: 210rpx; }
.draft-hero { margin-bottom: 22rpx; padding: 34rpx; overflow: hidden; border-radius: 30rpx; background: linear-gradient(145deg, #142019 0%, #29422c 100%); color: #fff; }
.hero-kicker { display: block; color: #bef260; font-size: 18rpx; font-weight: 900; letter-spacing: 3rpx; }
.hero-title { display: block; margin-top: 8rpx; font-size: 38rpx; font-weight: 900; }
.hero-note { display: block; margin-top: 12rpx; color: rgba(255,255,255,.62); font-size: 21rpx; line-height: 1.55; }
.chat-stream { margin-bottom: 18rpx; }.message-row { display: flex; margin-bottom: 14rpx; }.message-row.user { justify-content: flex-end; }.message-bubble { max-width: 78%; padding: 18rpx 22rpx; border-radius: 8rpx 23rpx 23rpx 23rpx; background: #fff; color: #48564d; font-size: 22rpx; line-height: 1.55; }.message-row.user .message-bubble { border-radius: 23rpx 8rpx 23rpx 23rpx; background: #172019; color: #eef7ef; }
.quick-prompts { margin: 0 -24rpx 20rpx; padding: 0 24rpx; white-space: nowrap; }.quick-prompt { display: inline-flex; margin-right: 12rpx; padding: 15rpx 21rpx; border: 1rpx solid #dce7de; border-radius: 999rpx; background: #fff; color: #34815a; font-size: 20rpx; font-weight: 750; }
.state-card { display: flex; flex-direction: column; align-items: center; padding: 48rpx 28rpx; border-radius: 25rpx; background: #fff; color: #748078; font-size: 23rpx; text-align: center; }
.loading-dot { width: 18rpx; height: 18rpx; margin-bottom: 20rpx; border-radius: 50%; background: #159255; box-shadow: 26rpx 0 #bef260, -26rpx 0 #172019; }
.error-card { color: #b34e3b; }.retry-button { margin-top: 22rpx; padding: 16rpx 28rpx; border-radius: 999rpx; background: #172019; color: #bef260; font-weight: 850; }
.draft-summary { display: flex; justify-content: space-around; margin-bottom: 22rpx; padding: 24rpx 12rpx; border-radius: 24rpx; background: #fff; }
.draft-summary view { flex: 1; text-align: center; border-right: 1rpx solid #e8ece8; }.draft-summary view:last-child { border-right: 0; }
.summary-value, .summary-label { display: block; }.summary-value { color: #172019; font-size: 35rpx; font-weight: 900; }.summary-label { margin-top: 4rpx; color: #8a958d; font-size: 19rpx; }
.fallback-note { margin-bottom: 20rpx; padding: 18rpx 22rpx; border-radius: 18rpx; background: #fff5d9; color: #835f16; font-size: 21rpx; line-height: 1.5; }
.section-heading { display: flex; align-items: baseline; justify-content: space-between; margin: 28rpx 4rpx 15rpx; }.section-heading text:first-child { color: #172019; font-size: 28rpx; font-weight: 900; }.section-heading text:last-child { color: #8a958d; font-size: 18rpx; }
.draft-exercise-card { margin-bottom: 18rpx; padding: 24rpx; border-radius: 25rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(25,45,31,.05); }
.exercise-head { display: flex; align-items: center; }.exercise-index { display: flex; align-items: center; justify-content: center; width: 52rpx; height: 52rpx; flex: none; margin-right: 15rpx; border-radius: 16rpx; background: #172019; color: #bef260; font-size: 22rpx; font-weight: 900; }
.exercise-copy { flex: 1; min-width: 0; }.exercise-name { display: block; overflow: hidden; color: #172019; font-size: 27rpx; font-weight: 900; text-overflow: ellipsis; white-space: nowrap; }.exercise-meta { display: block; margin-top: 5rpx; color: #929c94; font-size: 19rpx; }
.exercise-card-actions { display: flex; flex: none; align-items: center; gap: 8rpx; margin-left: 12rpx; }.replace-button, .remove-button { padding: 12rpx 17rpx; border-radius: 999rpx; font-size: 20rpx; font-weight: 850; }.replace-button { background: #edf7ef; color: #148a50; }.remove-button { background: #fff0ed; color: #bd5544; }.disabled { opacity: .5; }
.prescription-grid { display: flex; margin-top: 20rpx; padding: 18rpx 8rpx; border-radius: 18rpx; background: #f4f7f3; }.prescription-grid view { flex: 1; text-align: center; }.prescription-grid text { display: block; }.prescription-grid text:first-child { color: #26342b; font-size: 27rpx; font-weight: 900; }.prescription-grid text:last-child { margin-top: 3rpx; color: #8a958d; font-size: 17rpx; }
.prescription-grid .prescription-input { box-sizing: border-box; width: 82rpx; height: 44rpx; margin: 0 auto; border: 1rpx solid #dbe5dc; border-radius: 11rpx; background: #fff; color: #26342b; font-size: 27rpx; font-weight: 900; text-align: center; }
.weight-editor { display: flex; align-items: center; gap: 18rpx; margin-top: 14rpx; padding: 17rpx 18rpx; border: 1rpx solid #e4ebe5; border-radius: 17rpx; background: #fbfcfb; }.weight-editor.needs-weight { border-color: #edc28d; background: #fff8ed; }.weight-copy { flex: 1; min-width: 0; }.weight-title, .weight-note { display: block; }.weight-title { color: #26342b; font-size: 20rpx; font-weight: 850; }.weight-note { margin-top: 4rpx; color: #89958d; font-size: 17rpx; line-height: 1.4; }.weight-static { flex: none; padding: 11rpx 16rpx; border-radius: 13rpx; background: #edf7ef; color: #148a50; font-size: 20rpx; font-weight: 850; }.weight-input-wrap { display: flex; align-items: center; gap: 7rpx; width: 145rpx; flex: none; padding: 9rpx 13rpx; border-radius: 13rpx; background: #f0f4f0; color: #77837b; font-size: 18rpx; }.weight-input { width: 95rpx; color: #172019; font-size: 23rpx; font-weight: 850; text-align: right; }.weight-reminder { margin: 4rpx 0 20rpx; padding: 18rpx 22rpx; border-radius: 17rpx; background: #fff3df; color: #94601c; font-size: 20rpx; line-height: 1.5; }
.exercise-reason { display: block; margin-top: 16rpx; color: #718077; font-size: 20rpx; line-height: 1.5; }
.warning-card { margin-top: 22rpx; padding: 20rpx 24rpx; border-radius: 19rpx; background: #fff5e8; color: #8a6222; font-size: 20rpx; line-height: 1.55; }.warning-card text { display: block; }
.disclaimer { display: block; margin: 20rpx 12rpx; color: #929d95; font-size: 19rpx; line-height: 1.55; text-align: center; }
.nutrition-card { margin-top: 26rpx; padding: 24rpx; border-radius: 27rpx; background: #fff; box-shadow: 0 8rpx 24rpx rgba(25,45,31,.05); }.nutrition-heading { margin: 0 0 18rpx; }.nutrition-budget { display: flex; margin-bottom: 18rpx; padding: 18rpx 8rpx; border-radius: 18rpx; background: #f5f8f4; }.nutrition-budget view { flex: 1; text-align: center; }.nutrition-budget text { display: block; }.nutrition-budget text:first-child { color: #172019; font-size: 26rpx; font-weight: 900; }.nutrition-budget text:last-child { margin-top: 4rpx; color: #8a958d; font-size: 16rpx; }.meal-row { display: flex; align-items: flex-start; padding: 19rpx 0; border-top: 1rpx solid #edf0ed; opacity: .58; }.meal-row.selected { opacity: 1; }.meal-check { display: flex; align-items: center; justify-content: center; width: 34rpx; height: 34rpx; flex: none; margin: 4rpx 12rpx 0 0; border: 2rpx solid #cbd6cd; border-radius: 10rpx; color: #fff; font-size: 22rpx; font-weight: 900; }.meal-row.selected .meal-check { border-color: #159255; background: #159255; }.meal-slot { flex: none; margin-right: 14rpx; padding: 7rpx 11rpx; border-radius: 10rpx; background: #eaf6ed; color: #168a51; font-size: 17rpx; font-weight: 850; }.meal-copy { flex: 1; min-width: 0; }.meal-copy text { display: block; }.meal-copy text:first-child { color: #26342b; font-size: 23rpx; font-weight: 850; }.meal-copy text:nth-child(2) { margin-top: 5rpx; color: #8a958d; font-size: 17rpx; }.meal-copy .allergen { margin-top: 5rpx; color: #b06b39; font-size: 16rpx; }.meal-macro { flex: none; margin-left: 12rpx; text-align: right; }.meal-macro text { display: block; color: #8a958d; font-size: 16rpx; }.meal-macro text:first-child { color: #172019; font-size: 24rpx; font-weight: 900; }.nutrition-note { display: block; margin-top: 15rpx; color: #7c8980; font-size: 18rpx; line-height: 1.55; }
.nutrition-accept { display: flex; align-items: center; justify-content: center; min-height: 68rpx; margin-top: 18rpx; border-radius: 17rpx; background: #edf7ef; color: #148a50; font-size: 20rpx; font-weight: 850; }.nutrition-accept.accepted { background: #172019; color: #bef260; }
.draft-actions { display: flex; gap: 12rpx; margin-top: 22rpx; }
.secondary-action, .primary-action { display: flex; align-items: center; justify-content: center; min-height: 78rpx; border-radius: 19rpx; font-size: 22rpx; font-weight: 850; }.secondary-action { padding: 0 18rpx; background: #f1f4f1; color: #6c786f; }.secondary-action.regenerate { color: #148a50; }.primary-action { flex: 1; background: #172019; color: #bef260; }
.composer { position: fixed; z-index: 30; right: 0; bottom: 0; left: 0; display: flex; align-items: flex-end; gap: 12rpx; padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e4e9e5; background: rgba(255,255,255,.97); }.composer-input { box-sizing: border-box; min-height: 76rpx; max-height: 170rpx; flex: 1; padding: 18rpx 22rpx; border-radius: 22rpx; background: #f2f5f2; color: #26342b; font-size: 22rpx; line-height: 1.45; }.send-button { display: flex; align-items: center; justify-content: center; width: 108rpx; min-height: 76rpx; border-radius: 22rpx; background: #172019; color: #bef260; font-size: 21rpx; font-weight: 900; }
