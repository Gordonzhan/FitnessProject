.detail-page { padding-bottom: 80rpx; }.state-card { padding: 40rpx; border-radius: 24rpx; background: #fff; color: #77837b; text-align: center; }.error-card { color: #ad4a39; }.retry { display: block; margin-top: 16rpx; color: #15955b; font-weight: 850; }
.detail-hero { margin-bottom: 22rpx; padding: 36rpx; border-radius: 30rpx; background: #172019; color: #fff; }.hero-kicker, .card-kicker { display: block; color: #9bd64f; font-size: 18rpx; font-weight: 900; letter-spacing: 2rpx; }.hero-title { display: block; margin-top: 8rpx; font-size: 42rpx; font-weight: 900; }.hero-meta { display: block; margin-top: 10rpx; color: rgba(255,255,255,.62); font-size: 22rpx; }
.exercise-media { width: 100%; height: 420rpx; margin-bottom: 22rpx; border-radius: 28rpx; background: #dfe5df; }.guidance-card, .safety-card { margin-bottom: 20rpx; }.safety-card { border: 2rpx solid #f3d6bd; background: #fff8f1; }.card-title { display: block; margin-top: 5rpx; color: #172019; font-size: 30rpx; font-weight: 900; }.body-copy { display: block; margin-top: 16rpx; color: #57645b; font-size: 24rpx; line-height: 1.75; }
.metric-grid { display: flex; flex-wrap: wrap; margin-top: 18rpx; }.metric { width: 33.333%; padding: 14rpx 4rpx; text-align: center; box-sizing: border-box; }.metric text:first-child { display: block; color: #172019; font-size: 28rpx; font-weight: 900; }.metric text:last-child { display: block; margin-top: 4rpx; color: #929c95; font-size: 18rpx; }
.tag-row { display: flex; flex-wrap: wrap; margin-top: 16rpx; }.limit-tag { margin: 0 10rpx 10rpx 0; padding: 10rpx 16rpx; border-radius: 999rpx; background: #fff0e8; color: #a95835; font-size: 21rpx; }.alternative { display: flex; align-items: center; justify-content: space-between; min-height: 82rpx; border-bottom: 1rpx solid #edf1ed; color: #334139; font-size: 24rpx; font-weight: 800; }.fitness-notice { padding: 24rpx; border-radius: 20rpx; background: #eef3ee; color: #79857d; font-size: 20rpx; line-height: 1.6; }
