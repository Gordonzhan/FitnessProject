/* 菜谱目录：搜索筛选、来源标签、菜谱卡片及操作按钮。 */
.recipe-page {
  padding-top: 18rpx;
  padding-bottom: 240rpx;
}

.recipe-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 2rpx 4rpx 18rpx;
}

.recipe-toolbar .section-title {
  font-size: 40rpx;
  line-height: 1.15;
}

.recipe-summary {
  display: block;
  margin-top: 3rpx;
  color: #7d8981;
  font-size: 21rpx;
  font-weight: 600;
}

.create-recipe-button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  padding: 0 22rpx;
  border-radius: 20rpx;
  background: #172019;
  color: #bef260;
  font-size: 24rpx;
  font-weight: 800;
  box-shadow: 0 8rpx 20rpx rgba(23, 32, 25, 0.14);
}

.create-icon {
  margin-right: 5rpx;
  font-size: 30rpx;
  line-height: 1;
}

.create-recipe-button:active {
  transform: scale(0.97);
}

.recipe-search {
  display: flex;
  align-items: center;
  height: 76rpx;
  margin-bottom: 14rpx;
  padding: 0 20rpx;
  border: 2rpx solid #e0e7df;
  border-radius: 21rpx;
  background: #fff;
}
.recipe-search input { flex: 1; font-size: 27rpx; color: #172019; }
.search-icon { margin-right: 12rpx; color: #19a865; font-size: 32rpx; font-weight: 900; }
.search-clear { padding: 16rpx; color: #7c8880; font-size: 34rpx; }
.search-placeholder { color: #a9b2ab; }

.source-filter-bar {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}

.source-tabs {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.source-tab-row {
  display: inline-flex;
  padding-right: 10rpx;
}

.source-tab {
  margin-right: 10rpx;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  background: #e8ede8;
  color: #657168;
  font-size: 22rpx;
  font-weight: 800;
}

.source-tab.active {
  background: #172019;
  color: #bef260;
}

.source-tab.active.user {
  background: #e2f7eb;
  color: #148653;
  box-shadow: inset 0 0 0 2rpx #9cdbba;
}

.filter-trigger {
  position: relative;
  display: flex;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  height: 58rpx;
  padding: 0 18rpx;
  border: 2rpx solid #dfe6df;
  border-radius: 999rpx;
  background: #fff;
  color: #506057;
  font-size: 22rpx;
  font-weight: 800;
}

.filter-trigger.active {
  border-color: #172019;
  background: #172019;
  color: #bef260;
}

.filter-trigger-icon {
  margin-right: 6rpx;
  font-size: 25rpx;
  transform: rotate(90deg);
}

.filter-count {
  display: flex;
  align-items: center;
  justify-content: center;
  min-width: 28rpx;
  height: 28rpx;
  margin-left: 7rpx;
  padding: 0 7rpx;
  border-radius: 999rpx;
  background: #bef260;
  color: #172019;
  font-size: 17rpx;
}

.active-filters {
  display: flex;
  align-items: center;
  margin: -2rpx 0 16rpx;
  overflow: hidden;
}

.active-filter-label {
  flex-shrink: 0;
  margin-right: 10rpx;
  color: #89948c;
  font-size: 20rpx;
}

.active-filter-chip {
  flex-shrink: 0;
  margin-right: 9rpx;
  padding: 7rpx 13rpx;
  border-radius: 999rpx;
  background: #e8f7ee;
  color: #148653;
  font-size: 20rpx;
  font-weight: 700;
}

.active-filter-chip text {
  margin-left: 3rpx;
  color: #617067;
}

.recipe-card {
  overflow: hidden;
  margin-bottom: 22rpx;
  border: 2rpx solid transparent;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 10rpx 30rpx rgba(35, 54, 42, 0.07);
}

.recipe-card.is-selected {
  border-color: #b9ec61;
}

.recipe-main {
  display: flex;
  padding: 18rpx;
}

.recipe-main:active {
  background: #fbfcfa;
}

.recipe-cover {
  position: relative;
  flex-shrink: 0;
  width: 172rpx;
  height: 172rpx;
  overflow: hidden;
  border-radius: 24rpx;
  background: #e6ece5;
}

.recipe-cover image {
  width: 100%;
  height: 100%;
}

.recipe-placeholder {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  background: linear-gradient(145deg, #213127, #152019);
}

.placeholder-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 62rpx;
  height: 62rpx;
  border-radius: 50%;
  background: #bef260;
  color: #172019;
  font-size: 32rpx;
  font-weight: 900;
  transform: rotate(-8deg);
}

.placeholder-copy {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.6);
  font-size: 18rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
}

.selected-tag {
  position: absolute;
  top: 10rpx;
  left: 10rpx;
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  background: #bef260;
  color: #172019;
  font-size: 19rpx;
  font-weight: 800;
}

.recipe-content {
  display: flex;
  flex: 1;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  padding: 2rpx 2rpx 2rpx 20rpx;
}

.recipe-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
}

.recipe-name-wrap {
  min-width: 0;
}

.recipe-tag-row {
  display: flex;
  align-items: center;
  min-width: 0;
}

.source-badge {
  flex-shrink: 0;
  margin-right: 10rpx;
  padding: 5rpx 10rpx;
  border-radius: 999rpx;
  font-size: 18rpx;
  font-weight: 800;
  line-height: 1.2;
}

.source-badge.user {
  background: #e6f8ee;
  color: #148653;
}

.source-badge.system {
  background: #172019;
  color: #bef260;
}

.recipe-label {
  display: block;
  min-width: 0;
  overflow: hidden;
  color: #19a865;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.recipe-name {
  display: block;
  max-width: 340rpx;
  margin-top: 4rpx;
  overflow: hidden;
  color: #172019;
  font-size: 30rpx;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.recipe-goals {
  display: block;
  margin-top: 6rpx;
  color: #718078;
  font-size: 19rpx;
}

.recipe-chevron {
  color: #aeb6b0;
  font-size: 40rpx;
  line-height: 1;
}

.calorie-line {
  display: flex;
  align-items: baseline;
  margin-top: 12rpx;
}

.calorie-number {
  color: #ef7544;
  font-size: 36rpx;
  font-weight: 900;
  line-height: 1;
}

.calorie-unit {
  margin-left: 8rpx;
  color: #9ca59f;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
}

.macro-row {
  display: flex;
  margin-top: 14rpx;
}

.macro-chip {
  display: flex;
  align-items: center;
  margin-right: 8rpx;
  padding: 7rpx 10rpx;
  border-radius: 10rpx;
  background: #f0f4ef;
}

.macro-key {
  margin-right: 5rpx;
  color: #18a662;
  font-size: 18rpx;
  font-weight: 900;
}

.macro-value {
  color: #5e6961;
  font-size: 20rpx;
  font-weight: 700;
}

.macro-chip.carb .macro-key {
  color: #e4982d;
}

.macro-chip.fat .macro-key {
  color: #e45c70;
}

.recipe-actions {
  display: flex;
  align-items: center;
  padding: 13rpx 18rpx 16rpx;
  border-top: 1rpx solid #eef1ed;
}

.recipe-select {
  display: flex;
  flex: 1;
  align-items: center;
  justify-content: center;
  height: 64rpx;
  border-radius: 18rpx;
  background: #eaf8ef;
  color: #158b56;
  font-size: 24rpx;
  font-weight: 800;
}

.recipe-select.selected {
  background: #bef260;
  color: #172019;
}

.action-symbol {
  margin-right: 8rpx;
  font-size: 28rpx;
}

.recipe-delete {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 112rpx;
  height: 64rpx;
  margin-left: 12rpx;
  border-radius: 18rpx;
  background: #fff1ee;
  color: #d95a45;
  font-size: 24rpx;
  font-weight: 700;
}

.recipe-copy {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 132rpx;
  height: 64rpx;
  margin-left: 12rpx;
  border-radius: 18rpx;
  background: #172019;
  color: #bef260;
  font-size: 22rpx;
  font-weight: 800;
}
.catalog-status { padding: 24rpx 0; text-align: center; color: #8b958e; font-size: 23rpx; }

.recipe-select:active,
.recipe-delete:active {
  transform: scale(0.97);
}

.recipe-page .empty-state {
  padding: 52rpx 26rpx 46rpx;
}

.empty-actions {
  display: flex;
  justify-content: center;
}

.empty-actions .empty-action {
  margin-right: 6rpx;
  margin-left: 6rpx;
}

.empty-actions .empty-action.secondary {
  background: #e7f5ec;
  color: #148653;
}

.filter-overlay {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 100;
  display: flex;
  align-items: flex-end;
  background: rgba(15, 24, 18, 0.46);
  animation: overlay-in 160ms ease-out;
}

.filter-sheet {
  width: 100%;
  padding: 14rpx 28rpx calc(28rpx + env(safe-area-inset-bottom));
  border-radius: 36rpx 36rpx 0 0;
  background: #f8faf7;
  box-shadow: 0 -18rpx 50rpx rgba(20, 32, 25, 0.18);
  animation: sheet-in 200ms ease-out;
}

.sheet-handle {
  width: 76rpx;
  height: 8rpx;
  margin: 0 auto 24rpx;
  border-radius: 999rpx;
  background: #d5ddd6;
}

.sheet-heading {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 30rpx;
}

.sheet-eyebrow {
  display: block;
  color: #18a662;
  font-size: 19rpx;
  font-weight: 800;
  letter-spacing: 3rpx;
}

.sheet-title {
  display: block;
  margin-top: 4rpx;
  color: #172019;
  font-size: 36rpx;
  font-weight: 900;
}

.sheet-close {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 58rpx;
  height: 58rpx;
  border-radius: 50%;
  background: #e9eeea;
  color: #657168;
  font-size: 38rpx;
  line-height: 1;
}

.sheet-section {
  margin-bottom: 28rpx;
}

.sheet-label {
  display: block;
  margin-bottom: 13rpx;
  color: #445149;
  font-size: 23rpx;
  font-weight: 800;
}

.sheet-options {
  display: flex;
  flex-wrap: wrap;
}

.sheet-option {
  margin: 0 12rpx 12rpx 0;
  padding: 15rpx 24rpx;
  border: 2rpx solid transparent;
  border-radius: 999rpx;
  background: #e8ede8;
  color: #657168;
  font-size: 24rpx;
  font-weight: 800;
}

.sheet-option.active {
  border-color: #172019;
  background: #172019;
  color: #bef260;
}

.sheet-actions {
  display: flex;
  margin-top: 12rpx;
}

.sheet-reset,
.sheet-apply {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 84rpx;
  border-radius: 22rpx;
  font-size: 26rpx;
  font-weight: 800;
}

.sheet-reset {
  width: 180rpx;
  margin-right: 14rpx;
  background: #e8ede8;
  color: #526057;
}

.sheet-apply {
  flex: 1;
  background: #172019;
  color: #bef260;
}

@keyframes overlay-in {
  from { background: rgba(15, 24, 18, 0); }
  to { background: rgba(15, 24, 18, 0.46); }
}

@keyframes sheet-in {
  from { transform: translateY(100%); }
  to { transform: translateY(0); }
}
