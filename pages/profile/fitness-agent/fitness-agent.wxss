.agent-page { min-height: 100vh; box-sizing: border-box; padding: 24rpx 24rpx 190rpx; background: #f2f5f0; }
.agent-hero { margin-bottom: 22rpx; padding: 34rpx 30rpx; border-radius: 30rpx; background: linear-gradient(145deg,#142019,#28553b); color: #fff; }
.hero-heading { display:flex; align-items:center; justify-content:space-between; gap:18rpx; }
.clear-chat { padding:10rpx 16rpx; border:1rpx solid rgba(255,255,255,.28); border-radius:999rpx; color:rgba(255,255,255,.78); font-size:18rpx; }
.hero-kicker,.hero-title,.hero-note { display:block; }.hero-kicker { color:#bef260; font-size:18rpx; font-weight:900; letter-spacing:3rpx; }.hero-title { margin-top:10rpx; font-size:36rpx; font-weight:900; }.hero-note { margin-top:14rpx; color:rgba(255,255,255,.7); font-size:21rpx; line-height:1.6; }
.state-card,.welcome-card { margin-bottom:18rpx; padding:26rpx; border-radius:22rpx; background:#fff; color:#68766d; font-size:22rpx; line-height:1.6; text-align:center; }.error-card { color:#b55141; }.retry { margin-top:12rpx; color:#168a51; font-weight:800; }
.message-row { display:flex; margin-bottom:16rpx; }.message-row.user { justify-content:flex-end; }.message-bubble { max-width:84%; padding:20rpx 23rpx; border-radius:8rpx 23rpx 23rpx; background:#fff; color:#344138; font-size:23rpx; line-height:1.65; }.message-row.user .message-bubble { border-radius:23rpx 8rpx 23rpx 23rpx; background:#172019; color:#f3f8f3; }.message-bubble text { display:block; }
.pending,.basis { margin-top:10rpx; color:#89958d; font-size:17rpx; }.message-row.user .pending { color:rgba(255,255,255,.55); }
.draft-card { margin-top:18rpx; padding:20rpx; border-radius:18rpx; background:#edf7ef; }.draft-title { color:#172019; font-size:25rpx; font-weight:900; }.draft-meta { margin-top:7rpx; color:#718077; font-size:18rpx; }.draft-button { margin-top:16rpx; padding:16rpx; border-radius:14rpx; background:#172019; color:#bef260; font-weight:850; text-align:center; }
.citations { margin-top:18rpx; padding-top:14rpx; border-top:1rpx solid #e6ece7; }.citation-heading { color:#617067; font-size:18rpx; font-weight:800; }.citation-item { margin-top:12rpx; padding:14rpx; border-radius:14rpx; background:#f5f8f5; }.citation-title { color:#26342b; font-size:20rpx; font-weight:800; }.citation-meta { margin-top:4rpx; color:#7d8981; font-size:17rpx; }.citation-link { margin-top:8rpx; color:#168a51; font-size:18rpx; font-weight:750; }
.typing { margin:6rpx 0 20rpx; color:#758279; font-size:20rpx; }.quick-prompts { margin:0 -24rpx 18rpx; padding:0 24rpx; white-space:nowrap; }.quick-prompt { display:inline-flex; margin-right:12rpx; padding:14rpx 20rpx; border:1rpx solid #dbe5dd; border-radius:999rpx; background:#fff; color:#278458; font-size:19rpx; }
.safety-note { margin:20rpx 8rpx; color:#8b958e; font-size:18rpx; line-height:1.55; text-align:center; }
.composer { position:fixed; z-index:20; right:0; bottom:0; left:0; display:flex; align-items:flex-end; gap:12rpx; padding:16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom)); border-top:1rpx solid #e1e8e3; background:rgba(255,255,255,.98); }.composer-input { box-sizing:border-box; min-height:76rpx; max-height:170rpx; flex:1; padding:18rpx 20rpx; border-radius:22rpx; background:#f1f4f1; color:#26342b; font-size:22rpx; }.send-button { display:flex; align-items:center; justify-content:center; width:110rpx; min-height:76rpx; border-radius:22rpx; background:#172019; color:#bef260; font-size:21rpx; font-weight:900; }.disabled { opacity:.55; }
