.analysis-page { padding-bottom: 80rpx; }

.analysis-hero {
  position: relative;
  overflow: hidden;
  padding: 36rpx;
  border-radius: 32rpx;
  background: #172019;
  color: #ffffff;
  box-shadow: 0 18rpx 44rpx rgba(20, 32, 25, 0.16);
}

.analysis-hero::after { content: ""; position: absolute; right: -70rpx; bottom: -100rpx; width: 250rpx; height: 250rpx; border: 34rpx solid rgba(190, 242, 96, .1); border-radius: 50%; }
.analysis-kicker { display: block; color: #bef260; font-size: 18rpx; font-weight: 900; letter-spacing: 3rpx; }
.analysis-title { display: block; margin-top: 8rpx; font-size: 36rpx; font-weight: 900; }
.analysis-subtitle { display: block; margin-top: 8rpx; color: rgba(255,255,255,.56); font-size: 21rpx; }
.range-caption { display: inline-flex; margin-top: 26rpx; padding: 9rpx 16rpx; border-radius: 999rpx; background: rgba(255,255,255,.09); color: rgba(255,255,255,.82); font-size: 20rpx; }

.preset-row { display: flex; margin: 22rpx -10rpx 18rpx 0; }
.preset-chip { flex: 1; margin-right: 10rpx; padding: 18rpx 8rpx; border-radius: 18rpx; background: #ffffff; color: #6d796f; font-size: 22rpx; font-weight: 800; text-align: center; }
.preset-chip.active { background: #bef260; color: #172019; }
.range-card { padding: 22rpx; }
.range-pickers { display: flex; align-items: center; }
.range-picker { flex: 1; min-width: 0; padding: 16rpx; border-radius: 16rpx; background: #f5f8f4; }
.range-label { display: block; color: #9ba49e; font-size: 18rpx; }
.range-value { display: block; margin-top: 4rpx; color: #354139; font-size: 24rpx; font-weight: 800; }
.range-divider { margin: 0 12rpx; color: #9ba49e; }
.range-apply { margin-top: 16rpx; padding: 16rpx; border-radius: 15rpx; background: #172019; color: #bef260; font-size: 22rpx; font-weight: 800; text-align: center; }

.analysis-state { margin-top: 20rpx; color: #748078; font-size: 24rpx; text-align: center; }
.retry-button { margin-top: 18rpx; color: #15955b; font-weight: 800; }
.refresh-banner { display: flex; align-items: center; justify-content: space-between; margin-top: 18rpx; padding: 16rpx 20rpx; border-radius: 16rpx; background: #e9f8ef; color: #27704b; font-size: 21rpx; }
.refresh-error { background: #fff0ea; color: #a25339; }
.refresh-retry { flex-shrink: 0; margin-left: 18rpx; color: #15955b; font-weight: 850; }
.state-banner { display: flex; align-items: center; justify-content: space-between; margin-top: 22rpx; padding: 24rpx 28rpx; border-radius: 24rpx; background: #fff3ed; }
.state-banner.complete { background: #e9f8ef; }
.state-label { display: block; color: #9a7566; font-size: 18rpx; font-weight: 800; }
.state-title { display: block; margin-top: 3rpx; color: #4d3c35; font-size: 28rpx; font-weight: 900; }
.state-days { color: #7e6b63; font-size: 21rpx; }

.empty-panel { margin-top: 20rpx; padding: 48rpx 30rpx; text-align: center; }
.empty-mark { display: flex; align-items: center; justify-content: center; width: 68rpx; height: 68rpx; margin: 0 auto 18rpx; border-radius: 20rpx; background: #edf3ed; color: #7b887e; font-size: 32rpx; }
.empty-title { display: block; color: #3c4940; font-size: 28rpx; font-weight: 850; }
.empty-copy { display: block; margin-top: 10rpx; color: #929c95; font-size: 22rpx; line-height: 1.6; }

.metric-grid { display: flex; margin: 20rpx -12rpx 0 0; }
.metric-card { flex: 1; min-width: 0; margin-right: 12rpx; padding: 22rpx 16rpx; border-radius: 22rpx; background: #ffffff; }
.metric-label { display: block; min-height: 56rpx; color: #8a958d; font-size: 19rpx; line-height: 1.4; }
.metric-value { display: block; overflow: hidden; margin-top: 8rpx; color: #ef7544; font-size: 34rpx; font-weight: 900; text-overflow: ellipsis; }
.metric-value.green { color: #18a662; }
.metric-value.dark { color: #344139; }
.metric-unit { display: block; margin-top: 2rpx; color: #a4aca6; font-size: 17rpx; }

.assessment-card { margin-top: 20rpx; padding: 30rpx; border-radius: 27rpx; background: #fff1ea; }
.assessment-card.aligned { background: #e8f8ee; }
.assessment-kicker { display: block; color: #ca6945; font-size: 18rpx; font-weight: 900; letter-spacing: 2rpx; }
.aligned .assessment-kicker { color: #15955b; }
.assessment-title { display: block; margin-top: 7rpx; color: #342b27; font-size: 29rpx; font-weight: 900; }
.assessment-detail { display: block; margin-top: 12rpx; color: #796b64; font-size: 22rpx; line-height: 1.65; }

.chart-card { height: 520rpx; margin-top: 20rpx; padding: 26rpx 20rpx 18rpx; }
.chart-head { display: flex; align-items: baseline; justify-content: space-between; padding: 0 8rpx 12rpx; }
.chart-title { color: #26322b; font-size: 27rpx; font-weight: 850; }
.chart-note { color: #9ba49e; font-size: 18rpx; }
.analysis-chart { display: block; width: 100%; height: 430rpx; }

.macro-card, .completion-card, .weight-trend-card, .weight-form { margin-top: 20rpx; }
.macro-head, .weight-trend-head { display: flex; align-items: center; justify-content: space-between; }
.weight-chip { padding: 8rpx 14rpx; border-radius: 999rpx; background: #eef3ee; color: #526057; font-size: 20rpx; font-weight: 800; }
.macro-row { display: flex; align-items: center; justify-content: space-between; min-height: 76rpx; border-top: 1rpx solid #edf1ed; }
.macro-row:first-of-type { margin-top: 18rpx; }
.macro-name { font-size: 23rpx; font-weight: 850; }
.macro-name.protein { color: #6f7bf7; }.macro-name.carb { color: #d79228; }.macro-name.fat { color: #cf6687; }
.macro-range { color: #344139; font-size: 24rpx; font-weight: 800; }
.macro-note, .completion-note, .weight-form-note { display: block; margin-top: 14rpx; color: #949e97; font-size: 20rpx; line-height: 1.55; }
.completion-value { display: block; margin-top: 18rpx; color: #172019; font-size: 30rpx; font-weight: 900; }
.weight-trend-head > text:last-child { color: #98a199; font-size: 20rpx; }
.weight-change { margin-top: 18rpx; color: #172019; font-size: 42rpx; font-weight: 900; }
.weight-insufficient { display: block; margin-top: 18rpx; color: #8d9890; font-size: 22rpx; }

.weight-form-row { display: flex; align-items: center; margin-top: 20rpx; }
.weight-date { flex-shrink: 0; padding: 18rpx 14rpx; border-radius: 14rpx; background: #f3f6f2; color: #536057; font-size: 21rpx; }
.weight-input-wrap { display: flex; flex: 1; align-items: center; min-width: 0; margin-left: 10rpx; padding: 0 12rpx; border-radius: 14rpx; background: #f3f6f2; color: #869189; font-size: 20rpx; }
.weight-input-wrap input { flex: 1; min-width: 0; height: 68rpx; color: #26322b; font-size: 23rpx; }
.weight-save { flex-shrink: 0; margin-left: 10rpx; padding: 0 20rpx; border-radius: 14rpx; background: #172019; color: #bef260; font-size: 22rpx; font-weight: 800; line-height: 68rpx; }
.weight-save::after { border: none; }
.notice-list { margin-top: 22rpx; padding: 6rpx 8rpx; }
.notice-item { display: block; margin-top: 8rpx; color: #8d9790; font-size: 20rpx; line-height: 1.55; }
