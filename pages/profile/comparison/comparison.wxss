.comparison-page { padding-bottom: 90rpx; }

.comparison-hero {
  position: relative;
  overflow: hidden;
  margin-bottom: 24rpx;
  padding: 36rpx 34rpx;
  border-radius: 32rpx;
  background: #172019;
  color: #fff;
  box-shadow: 0 18rpx 44rpx rgba(20, 32, 25, 0.16);
}

.comparison-hero::after {
  content: "";
  position: absolute;
  right: -48rpx;
  bottom: -92rpx;
  width: 220rpx;
  height: 220rpx;
  border: 30rpx solid rgba(190, 242, 96, 0.1);
  border-radius: 50%;
}

.comparison-kicker, .section-kicker { display: block; color: #bef260; font-size: 18rpx; font-weight: 900; letter-spacing: 3rpx; }
.comparison-title { display: block; margin-top: 8rpx; font-size: 38rpx; font-weight: 900; }
.comparison-subtitle { display: block; margin-top: 8rpx; color: rgba(255,255,255,.58); font-size: 21rpx; }
.period-pill { display: inline-flex; margin-top: 25rpx; padding: 10rpx 16rpx; border-radius: 999rpx; background: rgba(255,255,255,.1); color: #dce5de; font-size: 20rpx; }

.state-card, .cohort-card, .metric-card, .leaderboard-card, .privacy-card, .demo-banner {
  margin-bottom: 22rpx;
  padding: 28rpx;
  border: 2rpx solid #e5ebe5;
  border-radius: 27rpx;
  background: #fff;
}
.state-card { padding: 60rpx 30rpx; text-align: center; }
.state-title { display: block; color: #172019; font-size: 29rpx; font-weight: 850; }
.state-note { display: block; margin-top: 12rpx; color: #879188; font-size: 21rpx; line-height: 1.6; }
.error-card { border-color: #f0d9d1; }
.retry-button { display: inline-flex; margin-top: 24rpx; padding: 16rpx 26rpx; border-radius: 999rpx; background: #172019; color: #bef260; font-size: 22rpx; font-weight: 800; }

.demo-banner { display: flex; align-items: center; border-color: #dce8f8; background: #f3f7fd; }
.demo-badge { flex-shrink: 0; margin-right: 18rpx; padding: 9rpx 12rpx; border-radius: 12rpx; background: #315fa8; color: #fff; font-size: 18rpx; font-weight: 900; letter-spacing: 2rpx; }
.demo-copy { flex: 1; }
.demo-title { display: block; color: #244d88; font-size: 24rpx; font-weight: 850; }
.demo-note { display: block; margin-top: 5rpx; color: #7188a7; font-size: 19rpx; }

.cohort-card { display: flex; align-items: center; justify-content: space-between; }
.section-kicker { color: #15955b; }
.cohort-label { display: block; margin-top: 7rpx; color: #26332b; font-size: 25rpx; font-weight: 800; }
.sample-count { flex-shrink: 0; margin-left: 18rpx; text-align: right; }
.sample-number { display: block; color: #172019; font-size: 40rpx; font-weight: 900; }
.sample-unit { display: block; color: #939c95; font-size: 18rpx; }

.section-heading { margin: 34rpx 4rpx 18rpx; }
.section-title { display: block; color: #172019; font-size: 31rpx; font-weight: 900; }
.section-subtitle { display: block; margin-top: 7rpx; color: #8c968f; font-size: 20rpx; line-height: 1.55; }
.metric-card { box-shadow: 0 10rpx 28rpx rgba(35,54,42,.05); }
.metric-topline { display: flex; align-items: flex-start; justify-content: space-between; }
.metric-label { display: block; color: #58645c; font-size: 22rpx; font-weight: 750; }
.metric-value-row { display: flex; align-items: baseline; margin-top: 5rpx; }
.metric-value { color: #172019; font-size: 46rpx; font-weight: 900; }
.metric-unit { margin-left: 7rpx; color: #79847c; font-size: 20rpx; font-weight: 700; }
.percentile-pill { margin-top: 8rpx; padding: 11rpx 16rpx; border-radius: 999rpx; background: #bef260; color: #172019; font-size: 19rpx; font-weight: 850; }
.percentile-pill.disabled { background: #edf1ed; color: #89938c; }
.percentile-track { height: 13rpx; margin-top: 23rpx; overflow: hidden; border-radius: 999rpx; background: #edf1ed; }
.percentile-fill { height: 100%; border-radius: 999rpx; background: linear-gradient(90deg, #22aa68, #bef260); }
.metric-description { display: block; margin-top: 13rpx; color: #929b94; font-size: 19rpx; line-height: 1.5; }

.leaderboard-card { margin-top: 30rpx; box-shadow: 0 10rpx 28rpx rgba(35,54,42,.05); }
.leaderboard-heading { display: flex; align-items: flex-start; justify-content: space-between; }
.leaderboard-title { display: block; margin-top: 7rpx; color: #172019; font-size: 28rpx; font-weight: 900; }
.my-rank { flex-shrink: 0; margin-left: 20rpx; text-align: right; }
.my-rank-label { display: block; color: #8c968f; font-size: 18rpx; }
.my-rank-value-row { display: flex; align-items: baseline; justify-content: flex-end; margin-top: 3rpx; }
.my-rank-value { color: #15955b; font-size: 38rpx; font-weight: 900; }
.my-rank-total { margin-left: 5rpx; color: #89938c; font-size: 19rpx; font-weight: 700; }
.leaderboard-list { margin-top: 24rpx; overflow: hidden; border: 2rpx solid #edf1ed; border-radius: 20rpx; }
.leaderboard-row { display: flex; align-items: center; min-height: 72rpx; padding: 0 20rpx; border-bottom: 2rpx solid #edf1ed; }
.leaderboard-row:last-child { border-bottom: 0; }
.rank-number { width: 52rpx; color: #15955b; font-size: 22rpx; font-weight: 900; }
.rank-name { flex: 1; color: #354139; font-size: 21rpx; font-weight: 750; }
.rank-band { color: #6f7b73; font-size: 20rpx; font-weight: 700; }
.leaderboard-note { display: block; margin-top: 16rpx; color: #929b94; font-size: 18rpx; line-height: 1.55; }

.privacy-card { margin-top: 30rpx; background: #f8faf7; }
.privacy-title { display: block; margin-bottom: 14rpx; color: #354139; font-size: 25rpx; font-weight: 850; }
.notice-row { display: flex; margin-top: 9rpx; }
.notice-dot { flex-shrink: 0; margin-right: 10rpx; color: #15955b; font-size: 22rpx; }
.notice-text { flex: 1; color: #7c8780; font-size: 20rpx; line-height: 1.55; }
