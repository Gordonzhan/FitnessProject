# local: no token required; staging/production: set a strong random value
FITNESS_AGENT_SERVICE_TOKEN=
FITNESS_AGENT_PROVIDER=fake
# 可选：未设置时沿用 FITNESS_AGENT_PROVIDER。
# FITNESS_AGENT_RECIPE_PROVIDER=ollama
# FITNESS_AGENT_WORKOUT_PROVIDER=ollama
# FITNESS_AGENT_CHAT_PROVIDER=ollama
FITNESS_AGENT_RECIPE_GENERATION_ENABLED=true
FITNESS_AGENT_LOG_LEVEL=INFO
# 本地默认写入 ai-agent/logs/fitness-agent.log；可用绝对路径覆盖。
# FITNESS_AGENT_LOG_FILE=/path/to/fitness-agent.log
FITNESS_AGENT_REQUEST_TIMEOUT_SECONDS=30

# Set FITNESS_AGENT_PROVIDER=ollama to use the local vision model.
FITNESS_AGENT_OLLAMA_BASE_URL=http://127.0.0.1:11434
FITNESS_AGENT_OLLAMA_MODEL=qwen3-vl:8b-instruct
FITNESS_AGENT_OLLAMA_TIMEOUT_SECONDS=180
FITNESS_AGENT_OLLAMA_RECIPE_MODEL=qwen3:8b
FITNESS_AGENT_OLLAMA_RECIPE_TIMEOUT_SECONDS=120
FITNESS_AGENT_OLLAMA_WORKOUT_MODEL=qwen3:8b
FITNESS_AGENT_OLLAMA_WORKOUT_TIMEOUT_SECONDS=120
FITNESS_AGENT_OLLAMA_AGENT_MODEL=qwen3:8b
FITNESS_AGENT_OLLAMA_AGENT_TIMEOUT_SECONDS=120
# 避免短时间无人提问后重复加载约 10 GB 的本地对话模型。
FITNESS_AGENT_OLLAMA_AGENT_KEEP_ALIVE=30m
# Python 回调 Java 只读 Tool API；令牌与 Java FITNESS_AGENT_SERVICE_TOKEN 保持一致。
FITNESS_AGENT_JAVA_INTERNAL_BASE_URL=http://127.0.0.1:8080/api
FITNESS_AGENT_JAVA_SERVICE_TOKEN=
FITNESS_AGENT_TOOL_TIMEOUT_SECONDS=8
FITNESS_AGENT_MAX_TOOL_ROUNDS=6
FITNESS_AGENT_MAX_IMAGE_BYTES=10485760
# Local development only. Keep false in staging and production.
FITNESS_AGENT_ALLOW_PRIVATE_IMAGE_URLS=false

# A8 RAG：仅索引 knowledge/documents 中 reviewStatus=APPROVED 的通用知识。
FITNESS_AGENT_KNOWLEDGE_ENABLED=false
FITNESS_AGENT_KNOWLEDGE_DIRECTORY=knowledge/documents
FITNESS_AGENT_KNOWLEDGE_CHUNK_SIZE=900
FITNESS_AGENT_KNOWLEDGE_MINIMUM_SCORE=0.35
# 普通测试固定使用 fake；本地真实入库建议使用 ollama + nomic-embed-text。
FITNESS_AGENT_EMBEDDING_PROVIDER=fake
FITNESS_AGENT_EMBEDDING_MODEL=nomic-embed-text
FITNESS_AGENT_EMBEDDING_DIMENSION=768
FITNESS_AGENT_EMBEDDING_TIMEOUT_SECONDS=30
FITNESS_AGENT_EMBEDDING_BATCH_SIZE=32
FITNESS_AGENT_QDRANT_URL=http://127.0.0.1:6333
FITNESS_AGENT_QDRANT_API_KEY=
FITNESS_AGENT_QDRANT_COLLECTION=fitness_knowledge_local_v1
FITNESS_AGENT_QDRANT_TIMEOUT_SECONDS=10
